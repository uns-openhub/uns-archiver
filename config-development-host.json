{
  "uns": {
    "graphql": "http://localhost:3200/graphql",
    "rest": "http://localhost:3200/api",
    "processName": "uns-archiver",
    "instanceMode": "handover",
    "handover": true,
    "jwksWellKnownUrl": "http://localhost:3200/api/.well-known/jwks.json",
    "kidWellKnownUrl": "http://localhost:3200/api/.well-known/kid",
    "supervisor": {
      "enabled": false
    },
    "env": "dev"
  },
  "infra": {
    "host": "localhost"
  },
  "archiver": {
    "inactiveBufferMax": 2000,
    "inactiveBufferMaxAgeMs": 300000,
    "ingestQueueMaxEvents": 256,
    "ingestQueueMaxBytes": 16777216,
    "ingestConcurrency": 1,
    "storedReplayBatchSize": 64,
    "storedReplayIntervalMs": 5000,
    "identityEnrichmentEnabled": false,
    "identityResolutionRetryMaxAgeMs": 30000,
    "traceIngest": false
  },
  "questdb": {
    "configurationString": "http::addr=localhost:9000;auto_flush=off",
    "batch": {
      "flushIntervalMs": 1000,
      "maxRows": 256,
      "maxPendingRows": 2048
    },
    "dataStorage": [
      {
        "tablePrefix": "uns_enterprise",
        "topic": "forge-group/#",
        "ingestMode": "dedup"
      }
    ]
  }
}
